# MOSEK task export summary for bd-2ste.1 fragmentation SOS certificate.
# This artifact is consumed by crates/frankenlibc-membrane/build.rs.
schema_version: 2
solver_family: mosek
certificate: fragmentation
dimension: 4
monomial_degree: 2
barrier_budget_milli: 800000
# Independent B(z) specification: constant plus these upper-triangular
# quadratic numerators (using the same runtime score divisor as Q).
# Check B + z^T Q z = budget; this is not a proof of system dynamics.
barrier_constant_milli: 800000
barrier_coefficients:
-1100,-300,-240,-200
0,-900,-200,-160
0,0,-1300,-400
0,0,0,-1000
gram_matrix:
1100,150,120,100
150,900,100,80
120,100,1300,200
100,80,200,1000
