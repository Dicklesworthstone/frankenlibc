# MOSEK task export summary for bd-2ste.4 size-class admissibility SOS certificate.
# This artifact is consumed by crates/frankenlibc-membrane/build.rs.
schema_version: 2
solver_family: mosek
certificate: size_class
dimension: 4
monomial_degree: 2
barrier_budget_milli: 150000
# Independent B(z) specification: constant plus these upper-triangular
# quadratic numerators (using the same runtime score divisor as Q).
# Check B + z^T Q z = budget; this is not a proof of system dynamics.
barrier_constant_milli: 150000
barrier_coefficients:
-1000,-80,-100,-40
0,-1800,-400,-200
0,0,-1200,-160
0,0,0,-900
gram_matrix:
1000,40,50,20
40,1800,200,100
50,200,1200,80
20,100,80,900
