# MOSEK task export summary for bd-2ste.2 thread-safety SOS certificate.
# This artifact is consumed by crates/frankenlibc-membrane/build.rs.
schema_version: 2
solver_family: mosek
certificate: thread_safety
dimension: 5
monomial_degree: 2
barrier_budget_milli: 900000
# Independent B(z) specification: constant plus these upper-triangular
# quadratic numerators (using the same runtime score divisor as Q).
# Check B + z^T Q z = budget; this is not a proof of system dynamics.
barrier_constant_milli: 900000
barrier_coefficients:
-350,-80,-120,-60,-60
0,-1200,-1800,-160,-160
0,0,-1500,-180,-180
0,0,0,-700,-240
0,0,0,0,-700
gram_matrix:
350,40,60,30,30
40,1200,900,80,80
60,900,1500,90,90
30,80,90,700,120
30,80,90,120,700
