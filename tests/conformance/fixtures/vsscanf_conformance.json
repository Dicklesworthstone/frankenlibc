{
  "version": "v1",
  "family": "vsscanf_conformance",
  "captured_at": "2026-08-31T00:00:00Z",
  "description": "vsscanf differential conformance: the va_list entry point of the scanf family. Cases reuse input/format pairs already proven for sscanf in scanf_conformance.json, so a failure here is attributable to the va_list path rather than to the case itself. mode=both so each case yields a strict row (host-parity checked against glibc vsscanf) and a hardened row, which is what a WrapsHostLibc -> Implemented promotion requires.",
  "spec_reference": "C11 7.21.6.2 (fscanf conversions), C11 7.21.6.14 (vsscanf)",
  "cases": [
    {
      "name": "vsscanf_d_basic",
      "function": "vsscanf",
      "spec_section": "C11 7.21.6.2 %d specifier via va_list",
      "inputs": { "input": "42", "format": "%d" },
      "expected_return": 1,
      "expected_values": [42],
      "expected_errno": 0,
      "mode": "both"
    },
    {
      "name": "vsscanf_d_negative",
      "function": "vsscanf",
      "spec_section": "C11 7.21.6.2 %d negative via va_list",
