      "expected_return": 1,
      "expected_values": [-123],
      "expected_errno": 0,
      "mode": "both"
    },
    {
      "name": "vsscanf_d_leading_ws",
      "function": "vsscanf",
      "spec_section": "C11 7.21.6.2 %d leading whitespace via va_list",
      "inputs": { "input": "   42", "format": "%d" },
      "expected_return": 1,
      "expected_values": [42],
      "expected_errno": 0,
      "mode": "both"
    },
    {
      "name": "vsscanf_u_basic",
