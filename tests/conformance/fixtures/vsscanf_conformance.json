      "inputs": { "input": "hello", "format": "%s" },
      "expected_return": 1,
      "expected_values": ["hello"],
      "expected_errno": 0,
      "mode": "both"
    },
    {
      "name": "vsscanf_s_stops_ws",
      "function": "vsscanf",
