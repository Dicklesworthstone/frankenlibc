      "spec_section": "C11 7.21.6.2 %x specifier via va_list",
      "inputs": { "input": "ff", "format": "%x" },
      "expected_return": 1,
      "expected_values": [255],
      "expected_errno": 0,
      "mode": "both"
    },
    {
