    "spdx_license": "BSD-2-Clause",
    "shared_upstream_limitation": "Both primary security cases exercise distinct memory directions (64-KiB heap overwrite in ZIP writer vs 64-byte LZSS window out-of-bounds heap read of 0x5801 bytes in RAR reader) within a single upstream C codebase (libarchive). Cross-application generalization remains a separate campaign."
  },
  "pinned_revisions": {
    "zip_vulnerable": {
      "role": "vulnerable_zip_writer",
      "tag": "v3.8.7",
      "tag_object": "cf3debc3fa8ca6db59e77fe99d0283f056c97004",
      "source_commit": "ded82291ab41d5e355831b96b0e1ff49e24d8939",
      "advisory_id": "GHSA-xgqq-r5j8-3mch",
      "cve_id": "CVE-2026-45308",
      "source_path": "libarchive/archive_write_set_format_zip.c",
      "mechanism": "cd_alloc allocates fixed 65536-byte central-directory segment via malloc(65536) and copy_path invokes memcpy(segment_ptr, pathname, pathlen) without rejecting pathlen > 0xffff"
    },
    "rar_vulnerable": {
      "role": "vulnerable_rar_reader",
      "tag": "v3.7.9",
      "tag_object": "ccf9843f055b40e2ac9e97628ef281e8d0558c62",
      "source_commit": "8a7a9cc527fd1d6d8664315d3bed47c4259479cc",
      "fixing_commit": "a612bf62f86a6faa47bd57c52b94849f0a404d8c",
      "advisory_id": "GHSA-6vpf-5947-22g5",
      "cve_id": "CVE-2025-5915",
      "source_path": "libarchive/archive_read_support_format_rar.c",
      "mechanism": "copy_from_lzss_window invokes memcpy(buffer, &rar->lzss.window[0], length - firstpart) when filter blocklength (0x5801) exceeds rar->dictionary_size (64-byte realloc heap allocation for unp_size=48), causing an out-of-bounds heap read"
    },
    "patched_reference": {
